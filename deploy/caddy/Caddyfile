{
	email {$ACME_EMAIL}
}

# Domain comes from the server's .env — never hardcode it here, the repo is public.
{$HOOKBOT_DOMAIN} {
	# DNS-01 challenge, so certificates work even behind Cloudflare's proxy
	# and without exposing port 80.
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
		# This network transparently redirects all port-53 DNS to a local server
		# that answers authoritatively for this zone with internal addresses and
		# does not carry the public _acme-challenge TXT. Setting `resolvers` does
		# not help — those queries are intercepted too — so the self-check can
		# never observe a record that is in fact published (confirmed over DoH).
		# Skip the check and let Let's Encrypt validate from the public internet,
		# where the record is visible. The delay gives Cloudflare time to publish.
		propagation_delay 30s
		propagation_timeout -1
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# API to the Rust server; everything else is the static SPA.
	handle /api/* {
		reverse_proxy server:3000
	}

	handle {
		reverse_proxy web:80
	}
}
