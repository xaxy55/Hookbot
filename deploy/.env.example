# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Public hostname Caddy should serve and request a certificate for.
HOOKBOT_DOMAIN=
# Contact address Let's Encrypt uses for expiry notices.
ACME_EMAIL=

# Cloudflare API token for the DNS-01 challenge.
# Needs Zone:DNS:Edit + Zone:Zone:Read on the zone only.
CLOUDFLARE_API_TOKEN=

# Admin password for the dashboard login.
ADMIN_PASSWORD=
# Shared key devices use to authenticate to the API.
API_KEY=
# Comma-separated origins allowed by CORS, e.g. https://your.domain
ALLOWED_ORIGINS=
