# Server configuration (all optional, defaults shown)
DATABASE_URL=data/hookbot.db
FIRMWARE_DIR=data/firmware
BIND_ADDR=0.0.0.0:3000
POLL_INTERVAL=10
LOG_RETENTION_HOURS=24
MDNS_PREFIX=hookbot
ADMIN_PASSWORD=

# CORS: comma-separated list of allowed origins (empty = allow any origin)
ALLOWED_ORIGINS=
# Used by the `make cli-*` targets and `make deploy`, so no hostname is
# hardcoded in the repo. Leave blank if you only work locally.
HOOKBOT_SERVER_URL=
HOOKBOT_FRONTEND_URL=
# SSH target for `make deploy`, e.g. root@your.server
DEPLOY_HOST=
